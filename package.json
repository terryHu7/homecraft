{
  "name": "homecraft",
  "version": "0.2.0",
  "private": true,
  "description": "Build your own Minecraft-inspired 3D personal website.",
  "keywords": [
    "personal-website",
    "homepage",
    "portfolio",
    "template",
    "threejs",
    "voxel",
    "webring",
    "vibe-coding"
  ],
  "homepage": "https://github.com/terryHu7/homecraft#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/terryHu7/homecraft.git"
  },
  "bugs": {
    "url": "https://github.com/terryHu7/homecraft/issues"
  },
  "author": "Terry (https://terryhu.cn)",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "serve": "python3 tools/serve.py",
    "update": "npx --yes https://github.com/terryHu7/homecraft/releases/latest/download/homecraft-updater.tgz",
    "test:updates": "node --test tools/update-engine.test.mjs",
    "release:prepare": "node tools/prepare-release.mjs",
    "check:site": "node tools/check-site.mjs",
    "check": "node tools/check-site.mjs && node tools/check.mjs",
    "check:portal": "node tools/sync-protocol.mjs --check && node tools/check-portal.mjs",
    "check:metadata": "node tools/check-metadata.mjs",
    "check:mailbox": "node --experimental-vm-modules tools/check-mailbox.cjs && node tools/check-mailbox-ui.cjs",
    "build": "bash tools/build.sh",
    "directory": "node tools/directory.mjs check",
    "test:listing": "node --test tools/listing-validation.test.mjs tools/listing-github.test.mjs tools/check-listing.test.mjs",
    "check:listing": "node tools/check-listing.mjs",
    "check:pr": "node tools/pr-check.mjs"
  },
  "devDependencies": {
    "playwright": "1.64.1"
  },
  "engines": {
    "node": ">=22"
  }
}
